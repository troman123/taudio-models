# Local model/runtime caches (never commit weights)
.cache/
*.ckpt
*.pth
*.pt
*.onnx
*.safetensors
*.bin
*.so
*.dylib
*.dll

# User I/O for Docker compose (keep placeholders)
data/in/*
!data/in/.gitkeep
data/out/*
!data/out/.gitkeep

# Vendored native trees: keep source/glue; never commit weights/binaries
libs/**/*
!libs/.gitkeep
!libs/**/README.md
!libs/**/NOTICE
!libs/**/*.py
!libs/**/*.yaml
!libs/**/*.yml
!libs/**/*.md
!libs/**/*.toml
!libs/**/*.cfg
!libs/**/*.json
!libs/**/py.typed

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Explicitly track MelBand RoFormer vendor source (weights still ignored via *.ckpt)
!libs/MelBandRoformer/
!libs/MelBandRoformer/**
libs/**/__pycache__/
.DS_Store
